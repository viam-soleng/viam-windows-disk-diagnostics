{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam:windows-diagnostics",
  "visibility": "public",
  "url": "https://github.com/viam-soleng/viam-windows-disk-diagnostics",
  "description": "Windows device telemetry sensors: disk, CPU, memory, and task list.",
  "models": [
    {
      "api": "rdk:component:sensor",
      "model": "viam:windows-diagnostics:disk",
      "short_description": "Reports disk space usage (total, free, used, percent) for a configured Windows volume.",
      "markdown_link": "README.md#model-viamwindows-diagnosticsdisk"
    },
    {
      "api": "rdk:component:sensor",
      "model": "viam:windows-diagnostics:cpu",
      "short_description": "Reports CPU usage and idle percentage using Windows GetSystemTimes.",
      "markdown_link": "README.md#model-viamwindows-diagnosticscpu"
    },
    {
      "api": "rdk:component:sensor",
      "model": "viam:windows-diagnostics:memory",
      "short_description": "Reports physical memory usage (total, available, used, percent) using Windows GlobalMemoryStatusEx.",
      "markdown_link": "README.md#model-viamwindows-diagnosticsmemory"
    },
    {
      "api": "rdk:component:sensor",
      "model": "viam:windows-diagnostics:tasklist",
      "short_description": "Reports the list of processes currently running on Windows.",
      "markdown_link": "README.md#model-viamwindows-diagnosticstasklist"
    }
  ],
  "applications": null,
  "markdown_link": "README.md",
  "entrypoint": "bin/windows-diagnostics",
  "first_run": "",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "windows/amd64"
    ]
  }
}
